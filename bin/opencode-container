#!/usr/bin/env bash
#
# OpenCode Container wrapper script
# Add this directory to your PATH to run the container-isolated OpenCode from anywhere
#
# Uses podman or docker (first found), or the engine named by $CONTAINER_ENGINE.
#
# Options:
#   -w, --websearch     Enable web search (sets OPENCODE_ENABLE_EXA=1)
#   -e, --experimental  Enable experimental features (sets OPENCODE_EXPERIMENTAL=1 and OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1)
#   -u, --update-config Overwrite ~/.opencode-container/config/ files with repo versions
#   --memory            Set memory limit (default: 4g, e.g., --memory 8g)
#   --cpus              Set CPU count (default: 4, e.g., --cpus 8)
#   --host-access       Add the engine's host alias so the container can reach host services
#
# Any other flags/commands (e.g. -m/--model, -c/--continue, -s/--session,
# auth logout, run "msg") are passed through to the OpenCode CLI.

set -e

UPDATE_CONFIG=0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ENGINE="${CONTAINER_ENGINE:-}"
if [ -z "$ENGINE" ]; then
    if command -v podman >/dev/null 2>&1; then
        ENGINE=podman
    elif command -v docker >/dev/null 2>&1; then
        ENGINE=docker
    else
        echo "Error: no container engine found; install podman/docker or set CONTAINER_ENGINE" >&2
        exit 1
    fi
fi

ocd_dir="$HOME/.opencode-container"
# One-time migration from the pre-rename docker-only state dir
if [ -d "$HOME/.opencode-docker" ] && [ ! -d "$ocd_dir" ]; then
    mv "$HOME/.opencode-docker" "$ocd_dir"
fi
repo_dir="${OPENCODE_CONTAINER_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

mkdir -p "$ocd_dir/config" "$ocd_dir/secrets"
chmod 700 "$ocd_dir" "$ocd_dir/config" "$ocd_dir/secrets"

# Remove env files created by older launcher versions; bootstrap reads mounted secrets.
rm -f "$ocd_dir/.env"

# Default workspace to current directory if not specified
WORKSPACE="${OPENCODE_WORKSPACE:-$(pwd)}"

if [ ! -d "$WORKSPACE" ]; then
    echo "Error: workspace path is not an existing directory: $WORKSPACE" >&2
    exit 1
fi

EXTRA_ENV=()
HOST_ARGS=()
HOST_ACCESS=0
MEMORY_LIMIT="${MEMORY_LIMIT:-4g}"
CPU_LIMIT="${CPU_LIMIT:-4}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--update-config)
            UPDATE_CONFIG=1
            shift
            ;;
        -w|--websearch)
            EXTRA_ENV+=("OPENCODE_ENABLE_EXA=1")
            shift
            ;;
        -e|--experimental)
            EXTRA_ENV+=("OPENCODE_EXPERIMENTAL=1" "OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1")
            shift
            ;;
        --memory)
            [ "$#" -ge 2 ] || { echo "error: --memory requires a value" >&2; exit 2; }
            MEMORY_LIMIT="$2"
            shift 2
            ;;
        --cpus)
            [ "$#" -ge 2 ] || { echo "error: --cpus requires a value" >&2; exit 2; }
            CPU_LIMIT="$2"
            shift 2
            ;;
        --host-access)
            HOST_ACCESS=1
            case "$ENGINE" in
                podman) HOST_ARGS+=(--add-host "host.containers.internal:host-gateway") ;;
                *)      HOST_ARGS+=(--add-host "host.docker.internal:host-gateway") ;;
            esac
            shift
            ;;
        *)
            break
            ;;
    esac
done

reject_proxy_credentials() {
    case "$1" in
        *://*@*)
            echo "error: proxy URLs with embedded credentials are not supported" >&2
            exit 2
            ;;
    esac
}

if [ -d "$repo_dir/config" ]; then
  if [ "$UPDATE_CONFIG" = 1 ]; then
    cp -a "$repo_dir/config/." "$ocd_dir/config/"
  else
    cp -a --update=none "$repo_dir/config/." "$ocd_dir/config/"
  fi
fi

ENV_ARGS=()
for assignment in "${EXTRA_ENV[@]}"; do
    ENV_ARGS+=(--env "$assignment")
done

# Forward host proxy settings (both cases; tools differ on which they read)
EFF_HTTP_PROXY="${HTTP_PROXY:-${http_proxy:-}}"
EFF_HTTPS_PROXY="${HTTPS_PROXY:-${https_proxy:-}}"
EFF_NO_PROXY="${NO_PROXY:-${no_proxy:-}}"
[ -n "$EFF_HTTP_PROXY" ] && reject_proxy_credentials "$EFF_HTTP_PROXY"
[ -n "$EFF_HTTPS_PROXY" ] && reject_proxy_credentials "$EFF_HTTPS_PROXY"
[ -n "$EFF_HTTP_PROXY" ] && ENV_ARGS+=(-e "HTTP_PROXY=$EFF_HTTP_PROXY" -e "http_proxy=$EFF_HTTP_PROXY")
[ -n "$EFF_HTTPS_PROXY" ] && ENV_ARGS+=(-e "HTTPS_PROXY=$EFF_HTTPS_PROXY" -e "https_proxy=$EFF_HTTPS_PROXY")
[ -n "$EFF_NO_PROXY" ] && ENV_ARGS+=(-e "NO_PROXY=$EFF_NO_PROXY" -e "no_proxy=$EFF_NO_PROXY")

if [ -t 0 ]; then
    RUN_FLAGS="-it"
else
    RUN_FLAGS="-i"
fi

USERNS_ARGS=()
if [ "$ENGINE" = podman ]; then
    # ponytail: keep-id is rootless-only; rootful podman (sudo) will reject it
    USERNS_ARGS=(--userns=keep-id)
fi

if [ "$HOST_ACCESS" = 1 ]; then
    echo "warning: host access is enabled; OpenCode can reach host services through the container gateway" >&2
fi

# ponytail: --memory/--cpus need cgroup v2 + systemd user session, else rootless podman warns and ignores them
"$ENGINE" run --rm $RUN_FLAGS \
    "${USERNS_ARGS[@]}" \
    --workdir /workspace \
    --read-only \
    --tmpfs /tmp:exec,size=512m,mode=1777 \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory="${MEMORY_LIMIT}" \
    --cpus="${CPU_LIMIT}" \
    "${ENV_ARGS[@]}" \
    "${HOST_ARGS[@]}" \
    -v "$HOME/.opencode-container:/app:rw,Z" \
    -v "$HOME/.opencode-container/config:/app/.config/opencode:rw,Z" \
    -v "$HOME/.opencode-container/secrets:/run/secrets:ro,Z" \
    -v "$WORKSPACE:/workspace:rw,Z" \
    opencode-container:latest "$@"
